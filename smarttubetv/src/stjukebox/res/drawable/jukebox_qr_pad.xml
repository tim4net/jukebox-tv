<?xml version="1.0" encoding="utf-8"?>
<!-- White pad behind the live join QR so it stays scannable on the dark attract art,
     with a neon-cyan stroke in the focused/pressed states so the D-pad focus ring is
     obvious while a room song is playing (the art's panel outline is the same cyan). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="4dp" android:color="#66F6FF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="4dp" android:color="#66F6FF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
